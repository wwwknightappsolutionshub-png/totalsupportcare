# Secrets — never commit. Prefer secrets/.env (not web-reachable).
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
!secrets/.env.example

*.log
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
