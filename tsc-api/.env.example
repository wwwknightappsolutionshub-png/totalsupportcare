# Prefer secrets/.env (not web-reachable). Root .env is a local fallback only.
# Copy: cp secrets/.env.example secrets/.env

PORT=8787
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_SITE_URL=https://www.totalsupportcare.co.uk
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@totalsupportcare.co.uk
ADMIN_PASSWORD=ChangeMeNow!Tsc2026
HR_EMAIL=hr@totalsupportcare.co.uk
HR_PASSWORD=HrTsc2026!
HR_NOTIFY_EMAIL=info@totalsupportcare.co.uk
HR_NOTIFY_PHONE=
COOKIE_SECURE=false
PACK_MARKETPLACE_ENABLED=false

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MS=1800000
AUTH_RESET_TOKEN_TTL_MS=1800000

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=false
# Required when NODE_ENV=production
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
APPLY_MIN_SUBMIT_MS=3000
